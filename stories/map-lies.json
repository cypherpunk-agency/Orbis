    {
      "title": "Why it happens",
      "text": "Mercator keeps angles true, which made it perfect for sailors with compasses. The price: everything gets stretched the further it sits from the equator. Near the poles, the stretch becomes enormous.",
      "view": {"mode": "mercator", "center": [-30, 55], "zoom": 1.6},
      "fills": {"GRL": "c2"},
      "highlight": ["GRL"]
    },
    {
      "title": "Now on a globe",
      "text": "A globe has no stretch at all. Here Greenland shows its true size: big, but nowhere near a continent.",
      "view": {"mode": "globe", "center": [-40, 68], "zoom": 1.1},
      "fills": {"GRL": "c2"},
      "highlight": ["GRL"]
    },
    {
