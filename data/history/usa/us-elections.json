    {
      "title": "1860: four candidates, a sectional map",
      "text": "The National Archives records electoral votes for Lincoln, Douglas, Breckinridge and Bell. New Jersey split its electors. Colours show certified allocations on modern reference outlines, not vote shares or exact 1860 boundaries.",
      "at": [
        -98,
        39
      ],
      "date": 1860,
      "kind": "0",
      "source": "Federal record / historic-site account",
      "url": "https://www.archives.gov/electoral-college/1860"
    },
    {
      "title": "New Jersey",
      "text": "In 1860 New Jersey appointed electors individually. Lincoln received four of its electoral votes and Douglas three; assigning the state entirely to either candidate would erase the split.",
      "at": [
        -74.5,
        40
      ],
      "date": 1860,
      "kind": "1",
      "source": "Federal record / historic-site account",
      "url": "https://www.archives.gov/electoral-college/1860"
    },
    {
      "title": "2020: two tickets, two split states",
      "text": "The certified 2020 Electoral College result was Biden 306, Trump 232. Maine and Nebraska split their allocations, so the purple category distinguishes them from states assigning all electors to one ticket.",
      "at": [
        -98,
        39
      ],
      "date": 2020,
      "kind": "2",
      "source": "Federal record / historic-site account",
      "url": "https://www.archives.gov/electoral-college/2020"
    },
    {
      "title": "Nebraska",
      "text": "Maine allocated three votes to Biden and one to Trump; Nebraska allocated one to Biden and four to Trump. These points locate the states. This chapter does not invent district boundaries or imply proportional popular-vote representation.",
      "at": [
        -99,
        41.5
      ],
      "date": 2020,
      "kind": "3",
      "source": "Federal record / historic-site account",
      "url": "https://www.archives.gov/electoral-college/2020"
    }
  ],
